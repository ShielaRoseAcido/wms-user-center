{
  "family": "wms-app-task",
  "executionRoleArn": "arn:aws:iam::861754177602:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "wms-app",
      "image": "861754177602.dkr.ecr.ap-southeast-1.amazonaws.com/wms-app:latest",
      "cpu": 0,
      "portMappings": [
        { "containerPort": 8080, "hostPort": 8080, "protocol": "tcp" }
      ],
      "essential": true,
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "default" },
        { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:postgresql://wms-db.c7gywe88chjv.ap-southeast-1.rds.amazonaws.com:5432/wms" },
        { "name": "SPRING_DATASOURCE_USERNAME", "value": "wms" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "value": "wms12345678" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/wms-app",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "volumes": []
}